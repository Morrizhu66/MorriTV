# 图片生成 API Key（必填）
ARK_API_KEY=

# 视频生成使用独立凭证；只使用图片功能时可留空
SEEDANCE_ARK_API_KEY=

# 灵感鸭 Sunburst Special 图片生成与编辑
LINGGANYA_API_KEY=

# 可选：将图片原图长期保存在私有 TOS Bucket（灵感鸭参考图直接上传）
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=
# 签名 URL 有效期（秒），建议 1800
TOS_SIGNED_URL_TTL=1800

# 可选：修改本地服务端口
MODEL_STUDIO_PORT=4178

# Private cloud workspace namespace; use a different ID for another workspace.
TOS_WORKSPACE_ID=default
