# 图片生成 API Key（必填）
ARK_API_KEY=

# 视频生成使用独立凭证；只使用图片功能时可留空
SEEDANCE_ARK_API_KEY=

# HFSY API 的图片与视频模型共用此凭证
HFSY_API_KEY=

# HFSY 本地参考素材会临时上传到私有火山引擎 TOS Bucket
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=
# 签名 URL 有效期（秒），建议 1800
TOS_SIGNED_URL_TTL=1800

# 可选：修改本地服务端口
MODEL_STUDIO_PORT=4178
